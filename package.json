{
  "name": "arjunos",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc -b",
    "build": "tsx scripts/validate-publication.ts && tsc -b && vite build && tsx scripts/prerender.ts && tsx scripts/resume-pdf.ts && tsx scripts/verify-static.ts && tsx scripts/validate-publication.ts --dist",
    "content:validate": "tsx scripts/validate-publication.ts",
    "publish:prepare": "tsx scripts/prepare-publication.ts",
    "preview": "vite preview --host 127.0.0.1",
    "images": "node scripts/optimize-images.mjs",
    "test": "vitest run",
    "test:studio": "tsx scripts/test-studio-workflow.ts",
    "test:e2e": "npm run build && playwright test",
    "resume:pdf": "tsx scripts/resume-pdf.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
